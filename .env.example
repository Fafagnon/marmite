# Noms de variables seulement, jamais de valeur réelle ici.
# Copie ce fichier vers .env.local pour le développement local,
# puis colle ta clé dans .env.local (fichier ignoré par git).
GEMINI_API_KEY=
# Modèle Gemini à utiliser. Défaut si vide : gemini-3.8-flash.
# Pour le niveau gratuit, mets un Flash-Lite, par exemple gemini-3.5-flash-lite.
GEMINI_MODEL=
